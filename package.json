{
  "name": "transposing-sketchpad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude 'tests/e2e/**' && playwright test",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^22.15.30",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}
